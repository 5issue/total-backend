# 로컬 전용 실제 시크릿. 이 파일을 application-secret.yml 로 복사해 값을 채운다.
#   cp application-secret.yml.example application-secret.yml
#
# application-secret.yml 은 .gitignore 에 등록되어 있어 커밋되지 않는다.

# 토스페이먼츠 테스트 시크릿 키.
#   발급처: https://developers.tosspayments.com/my/api-keys (개발자센터 > 내 개발정보 > API 키)
#   테스트 키는 test_sk_ 로 시작한다. 실제 결제가 일어나지 않는다.
#
# 키를 채운 뒤 실제 토스와 통신하려면 payment.pg.client 를 toss 로 바꾼다.
#   PAYMENT_PG_CLIENT=toss ./gradlew :payment-service:bootRun
toss:
  secret-key: "test_sk_여기에_붙여넣기"
