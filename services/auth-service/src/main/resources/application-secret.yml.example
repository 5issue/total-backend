# 로컬 전용 실제 시크릿. 이 파일을 application-secret.yml 로 복사해 값을 채운다.
#   cp application-secret.yml.example application-secret.yml
#
# application-secret.yml 은 .gitignore 에 등록되어 있어 커밋되지 않는다.
# 없어도 기동은 되지만(optional import) 소셜 로그인은 동작하지 않는다.
oauth:
  providers:
    kakao:
      # 카카오 개발자센터 → 앱 설정 → 앱 키 → REST API 키
      client-id: "PUT_KAKAO_REST_API_KEY_HERE"
      # 보안 설정을 "사용함"으로 켠 경우에만 필요
      client-secret: ""
    naver:
      client-id: "PUT_NAVER_CLIENT_ID_HERE"
      client-secret: "PUT_NAVER_CLIENT_SECRET_HERE"

# 재기동해도 기존 토큰을 유지하고 싶을 때만 채운다(EC P-256 JWK JSON).
# 비워두면 기동할 때마다 임시 키가 생성된다.
#jwt:
#  private-jwk: '{"kty":"EC","crv":"P-256","kid":"...","x":"...","y":"...","d":"..."}'
