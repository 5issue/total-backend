# cp .env.example .env 후 값을 채운다. .env는 커밋되지 않는다.
#
# 비워두면 docker-compose.yml의 기본값(guest/kurly/root)이 쓰인다. 로컬 컨테이너는
# 127.0.0.1에만 게시되므로 그대로도 동작하지만, 공유 장비에서 개발한다면 채워서 쓴다.

RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# 서비스 DB 공통 계정 (docker-compose의 각 DB 컨테이너와 application.yml이 함께 사용)
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
